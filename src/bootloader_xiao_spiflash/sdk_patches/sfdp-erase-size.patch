--- a/bootloader/platform/bootloader/storage/spiflash_sfdp/btl_storage_spiflash_sfdp.c
+++ b/bootloader/platform/bootloader/storage/spiflash_sfdp/btl_storage_spiflash_sfdp.c
@@ -397,15 +397,15 @@
   spi_setCsInactive();
 
   //This field specifies ‘N’ and is used to calculate  erase type size = 2^N bytes
-  if (type4) {
-    return (1U << type4);
-  } else if (type3) {
-    return (1U << type3);
-  } else if (type2) {
-    return (1U << type2);
-  } else {
-    return (1U << type1);
-  }
+  // Erase types are not sorted by size. P25Q32SH advertises a 256-byte
+  // type 4 after its 64 KiB type 3. Choosing the last populated type makes
+  // storage_eraseRaw issue its hardcoded 0xD8 (64 KiB) command once per
+  // 256 bytes, destroying data outside the requested range.
+  uint32_t largest = type1;
+  if (type2 > largest) { largest = type2; }
+  if (type3 > largest) { largest = type3; }
+  if (type4 > largest) { largest = type4; }
+  return (1U << largest);
 }
 
